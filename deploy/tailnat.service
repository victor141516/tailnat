[Unit]
Description=TailNAT tailnet-only port forwarding control plane
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service netfilter-persistent.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/tailnat --config /etc/tailnat/config.json --web-dir /opt/tailnat/web
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/tailnat
ProtectHome=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
